JWT_REFRESH_EXPIRES_IN_DAYS=7

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Optional: signs class join QR tokens (falls back to JWT_SECRET)
CLASS_JOIN_CODE_SECRET=
